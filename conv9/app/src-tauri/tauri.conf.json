{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Convolution Playground",
  "version": "0.1.0",
  "identifier": "com.babymastodon.conv9-listener",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Convolution Playground",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 640,
        "decorations": true,
        "minimizable": false,
        "maximizable": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; media-src 'self' blob:; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}
